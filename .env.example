# Copy to .env locally. Never commit actual credentials.
INSIGHTFLOW_DATABASE_URL=
INSIGHTFLOW_ADMIN_DATABASE_URL=
INSIGHTFLOW_MODE=mock
DEEPSEEK_API_KEY=
INSIGHTFLOW_ENABLE_LIVE=false
INSIGHTFLOW_MAX_MODEL_CALLS=3
INSIGHTFLOW_MAX_COST_USD=0.05
# Configure conservative input/output USD-per-million rates before live mode.
INSIGHTFLOW_INPUT_PRICE_PER_MILLION=
INSIGHTFLOW_OUTPUT_PRICE_PER_MILLION=
INSIGHTFLOW_TEST_DATABASE_URL=
INSIGHTFLOW_TEST_ADMIN_DATABASE_URL=
INSIGHTFLOW_DEEPSEEK_MODEL=deepseek-flash
# Never set automatically. Paid experiments require explicit user opt-in.
INSIGHTFLOW_ENABLE_PAID_EVAL=0
INSIGHTFLOW_MAX_OUTPUT_TOKENS=1024
INSIGHTFLOW_MODEL_TIMEOUT_SECONDS=15
INSIGHTFLOW_MODEL_RETRIES=1

# V2: configure locally; runtime role has only agent_runtime privileges.
INSIGHTFLOW_V2_RUNTIME_URL=
INSIGHTFLOW_V2_TEST_RUNTIME_URL=
INSIGHTFLOW_V2_AUTH_TOKENS=
INSIGHTFLOW_V2_MODE=mock
INSIGHTFLOW_V2_LIVE_ENABLED=false
INSIGHTFLOW_V2_MODEL=deepseek-flash
INSIGHTFLOW_V2_THINKING_EFFORT=max
INSIGHTFLOW_V2_EXPERIMENT_ID=upgrade-v2-20261017
INSIGHTFLOW_V2_PROJECT_BUDGET_USD=2.00
INSIGHTFLOW_V2_INPUT_PRICE_PER_MILLION=0.30
INSIGHTFLOW_V2_OUTPUT_PRICE_PER_MILLION=1.20
INSIGHTFLOW_V2_MAX_OUTPUT_TOKENS=8192
INSIGHTFLOW_V2_MAX_HTTP_ATTEMPTS=500
INSIGHTFLOW_V2_REQUEST_SECONDS=180
INSIGHTFLOW_V2_SEED101_URL=
INSIGHTFLOW_V2_SEED202_URL=
